<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CordaSa — Tanpura</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><rect width='64' height='64' rx='14' fill='#16120f'/><path d='M9 27 L55 14 Q57 13.6 57 16 L57 51 Q57 53 55 53 L9 53 Q7 53 7 51 L7 29 Q7 27.6 9 27 Z' fill='#e8913a'/><rect x='11' y='45.5' width='42' height='3' rx='1.5' fill='#16120f'/><line x1='15' y1='28.3' x2='15' y2='47' stroke='#fff' stroke-width='1.6' stroke-linecap='round'/><circle cx='15' cy='28.3' r='1.9' fill='#fff'/><line x1='20' y1='26.9' x2='20' y2='47' stroke='#fff' stroke-width='1.6' stroke-linecap='round'/><circle cx='20' cy='26.9' r='1.9' fill='#fff'/><line x1='25' y1='25.5' x2='25' y2='47' stroke='#fff' stroke-width='1.6' stroke-linecap='round'/><circle cx='25' cy='25.5' r='1.9' fill='#fff'/><line x1='30' y1='24.1' x2='30' y2='47' stroke='#fff' stroke-width='1.6' stroke-linecap='round'/><circle cx='30' cy='24.1' r='1.9' fill='#fff'/><line x1='35' y1='22.7' x2='35' y2='47' stroke='#fff' stroke-width='1.6' stroke-linecap='round'/><circle cx='35' cy='22.7' r='1.9' fill='#fff'/><line x1='40' y1='21.2' x2='40' y2='47' stroke='#fff' stroke-width='1.6' stroke-linecap='round'/><circle cx='40' cy='21.2' r='1.9' fill='#fff'/><line x1='45' y1='19.8' x2='45' y2='47' stroke='#fff' stroke-width='1.6' stroke-linecap='round'/><circle cx='45' cy='19.8' r='1.9' fill='#fff'/><line x1='50' y1='18.4' x2='50' y2='47' stroke='#fff' stroke-width='1.6' stroke-linecap='round'/><circle cx='50' cy='18.4' r='1.9' fill='#fff'/></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#16120f; --panel:#211b16; --panel2:#2a231c; --line:#3a3027;
    --text:#f3ebe1; --muted:#a8998a; --accent:#e8913a; --accent2:#f4b860;
  }
  *{box-sizing:border-box}
  html,body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,system-ui,sans-serif}
  body{padding:20px 16px 40px}
  .wrap{max-width:820px;margin:0 auto;display:grid;gap:16px}
  header{display:flex;align-items:baseline;justify-content:space-between;gap:12px;flex-wrap:wrap}
  h1{font-size:22px;margin:0}
  h1 span{color:var(--accent)}
  .hint{color:var(--muted);font-size:13px}
  .card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:16px}
  .card h2{font-size:13px;text-transform:uppercase;letter-spacing:1.2px;color:var(--muted);margin:0 0 12px;font-weight:600;display:flex;justify-content:space-between;align-items:center;gap:10px}
  .notes{display:grid;grid-template-columns:repeat(12,1fr);gap:6px}
  .notes button{padding:12px 0;font-size:15px;font-weight:600;border-radius:9px;border:1px solid var(--line);background:var(--panel2);color:var(--text);cursor:pointer}
  .notes button.sharp{background:#1b1612;color:#d8ccbe}
  .notes button.on{background:var(--accent);border-color:var(--accent);color:#1a120a}
  .row{display:flex;gap:16px;flex-wrap:wrap;align-items:center;margin-top:14px}
  .ctl{display:flex;flex-direction:column;gap:6px;min-width:160px;flex:1}
  .ctl label{font-size:12px;color:var(--muted);display:flex;justify-content:space-between}
  .ctl label b{color:var(--text);font-weight:600}
  input[type=range]{width:100%;accent-color:var(--accent)}
  .seg{display:flex;border:1px solid var(--line);border-radius:9px;overflow:hidden}
  .seg button{flex:1;padding:9px 10px;background:var(--panel2);color:var(--text);border:0;border-right:1px solid var(--line);cursor:pointer;font:inherit;font-size:14px}
  .seg button:last-child{border-right:0}
  .seg button.on{background:var(--accent);color:#1a120a;font-weight:600}
  .play{width:100%;padding:16px;font-size:17px;border-radius:12px;border:1px solid var(--accent);background:transparent;color:var(--accent);font-family:inherit;font-weight:600;cursor:pointer}
  .play.on{background:var(--accent);color:#1a120a}
  .status{font-size:12px;color:var(--muted);min-height:16px;text-transform:none;letter-spacing:0;font-weight:500}
  footer{color:var(--muted);font-size:12px;line-height:1.5}

  /* toggle switch */
  .sw{display:inline-flex;align-items:center;gap:8px;cursor:pointer;text-transform:none;letter-spacing:0;font-size:13px;color:var(--text);font-weight:500;user-select:none}
  .sw input{display:none}
  .sw i{width:36px;height:20px;border-radius:999px;background:var(--line);position:relative;transition:background .15s}
  .sw i::after{content:'';position:absolute;top:3px;left:3px;width:14px;height:14px;border-radius:50%;background:var(--text);transition:left .15s}
  .sw input:checked + i{background:var(--accent)}
  .sw input:checked + i::after{left:19px;background:#1a120a}

  /* pattern timeline */
  .tl{position:relative;height:74px;margin-top:18px;user-select:none;touch-action:none}
  .tl .segs{position:absolute;inset:0;display:flex;border-radius:10px;overflow:hidden;border:1px solid var(--line)}
  .tl .s{position:relative;background:var(--panel2);border-right:1px solid var(--line);display:flex;flex-direction:column;justify-content:center;padding:0 10px;min-width:0;transition:background .5s}
  .tl .s:last-child{border-right:0}
  .tl .s::before{content:'';position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--accent)}
  .tl .s .n{font-weight:700;font-size:15px;white-space:nowrap}
  .tl .s .v{font-size:12px;color:var(--muted);white-space:nowrap;margin-top:2px}
  .tl .s.hit{background:#4a3017;transition:none}
  .tl .h{position:absolute;top:-6px;bottom:-6px;width:22px;margin-left:-11px;cursor:ew-resize;display:flex;align-items:center;justify-content:center;z-index:2}
  .tl .h::after{content:'';width:6px;height:44px;border-radius:3px;background:var(--accent2);box-shadow:0 0 0 3px var(--panel)}
  .tl .h:hover::after,.tl .h.drag::after{background:#fff}
  .presets{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}
  .presets button{padding:7px 12px;border-radius:999px;border:1px solid var(--line);background:var(--panel2);color:var(--text);font:inherit;font-size:13px;cursor:pointer}
  .presets button.on{border-color:var(--accent);color:var(--accent)}
  .ratio{font-size:12px;color:var(--muted);margin-top:10px}
  .ratio b{color:var(--text)}
  .off{opacity:.45}
  .eq{margin-top:16px;border-top:1px solid var(--line);padding-top:14px}
  .eq .top{display:flex;justify-content:space-between;align-items:center;font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:1.2px;font-weight:600}
  .eq .top button{background:none;border:1px solid var(--line);color:var(--muted);border-radius:999px;padding:4px 10px;font:inherit;font-size:11px;letter-spacing:.5px;cursor:pointer;text-transform:none}
  .eq .top button:hover{color:var(--text)}
  .eq .bands{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:10px}
  .eq .band{display:flex;flex-direction:column;gap:4px}
  .eq .band label{font-size:12px;color:var(--muted);display:flex;justify-content:space-between}
  .eq .band label b{color:var(--text);font-weight:600}
  .eq .band small{font-size:10px;color:var(--muted)}
  @media (max-width:600px){ .eq .bands{grid-template-columns:repeat(2,1fr)} }
  @media (max-width:600px){ .notes{grid-template-columns:repeat(6,1fr)} .tl .s .v{display:none} }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>Corda<span>Sa</span> <small style="font-size:14px;font-weight:500;color:var(--muted);margin-left:6px">Tanpura</small></h1>
    <div class="hint">Space = start/stop</div>
  </header>

  <section class="card">
    <h2>Sa (tonic) <span class="status" id="tuneStatus"></span></h2>
    <div class="notes" id="notes"></div>
    <div class="row">
      <div class="ctl">
        <label>Fine tune <b id="centsVal">0 cents</b></label>
        <input type="range" id="cents" min="-50" max="50" step="1" value="0">
      </div>
      <div class="ctl" style="flex:0 0 auto">
        <label>Sa frequency</label>
        <div style="font-size:15px;font-weight:600" id="freqVal">—</div>
      </div>
      <div class="ctl" style="flex:2">
        <label>First string</label>
        <div class="seg" id="firstStr">
          <button data-v="Pa">Pa</button><button data-v="Ma">Ma</button><button data-v="Ni">Ni</button><button data-v="ni">ni (komal)</button>
        </div>
      </div>
    </div>
  </section>

  <button class="play" id="play">▶ Play</button>

  <section class="card" id="pluckCard">
    <h2>Plucks <label class="sw"><input type="checkbox" id="pluckOn"><i></i>On</label></h2>
    <div class="row" style="margin-top:0">
      <div class="ctl">
        <label>Full cycle <b id="tSpeedVal"></b></label>
        <input type="range" id="tSpeed" min="2" max="12" step="0.1">
      </div>
      <div class="ctl">
        <label>Volume <b id="tVolVal"></b></label>
        <input type="range" id="tVol" min="0" max="1" step="0.01">
      </div>
    </div>

    <div class="tl" id="tl">
      <div class="segs" id="segs"></div>
    </div>
    <div class="ratio" id="ratio"></div>
    <div class="presets" id="presets"></div>
    <div class="ratio">Drag the handles to change how long each string rings before the next pluck.</div>
    <div class="eq" id="eqT"></div>
  </section>

  <section class="card" id="droneCard">
    <h2>Drone <label class="sw"><input type="checkbox" id="droneOn"><i></i>On</label></h2>
    <div class="row" style="margin-top:0">
      <div class="ctl">
        <label>Volume <b id="dVolVal"></b></label>
        <input type="range" id="dVol" min="0" max="1" step="0.01">
      </div>
      <div class="ctl">
        <label>Brightness <b id="dBrightVal"></b></label>
        <input type="range" id="dBright" min="0" max="1" step="0.01">
      </div>
      <div class="ctl">
        <label>Shimmer <b id="dShimVal"></b></label>
        <input type="range" id="dShim" min="0" max="1" step="0.01">
      </div>
    </div>
    <div class="ratio">A soft, steady Sa · low Sa · first-string tone under the plucks.</div>
    <div class="eq" id="eqD"></div>
  </section>

  <footer>Synthesized in your browser — works offline once loaded. Settings are remembered on this browser.</footer>
</div>

<script>
(() => {
  const NOTES = ['C','C#','D','D#','E','F','F#','G','G#','A','A#','B'];
  const C3 = 130.8128;
  const FIRST = { Pa: 3/4, Ma: 2/3, Ni: 15/16, ni: 9/10 }; // mandra-saptak ratios to Sa
  const PRESETS = [
    { name:'Classic',      g:[4,4,4,9] },
    { name:'Even',         g:[1,1,1,1] },
    { name:'Long rest',    g:[3,3,3,12] },
    { name:'Lingering Pa', g:[7,3,3,8] },
    { name:'Quick Sa-Sa',  g:[5,2,2,9] },
  ];

  const DEF = { sa:1, cents:0, first:'Pa', tSpeed:4.5, tVol:0.7, gaps:[4,4,4,9],
                pluckOn:true, droneOn:true, dVol:0.35, dBright:0.5, dShim:0.5,
                eqT:[0,0,0,0], eqD:[0,0,0,0] };
  let S = JSON.parse(JSON.stringify(DEF));
  try { const s = JSON.parse(localStorage.getItem('riyaz') || '{}'); for (const k in DEF) if (k in s) S[k] = s[k]; } catch(e) {}
  ['eqT','eqD'].forEach(k => { if (!Array.isArray(S[k]) || S[k].length !== 4) S[k] = [0,0,0,0]; });
  if (!Array.isArray(S.gaps) || S.gaps.length !== 4) S.gaps = DEF.gaps.slice();
  const save = () => { try { localStorage.setItem('riyaz', JSON.stringify(S)); } catch(e) {} };
  const saFreq = () => C3 * Math.pow(2, (S.sa * 100 + S.cents) / 1200);
  const $ = s => document.querySelector(s);
  const stringNames = () => [S.first, 'Sa', 'Sa', 'Sa ↓'];

  // ---------- audio core ----------
  let ctx, comp, tanGain, droneGain, tanBufs = null, building = false, pendingBuild = false;
  function ensureCtx() {
    if (!ctx) {
      ctx = new (window.AudioContext || window.webkitAudioContext)();
      comp = ctx.createDynamicsCompressor();
      comp.threshold.value = -10; comp.ratio.value = 4;
      comp.connect(ctx.destination);
      tanGain = ctx.createGain(); tanGain.gain.value = S.tVol;
      droneGain = ctx.createGain(); droneGain.gain.value = 0;
      eqNodes.eqT = makeEQ(tanGain, comp, S.eqT);
      eqNodes.eqD = makeEQ(droneGain, comp, S.eqD);
      buildTanpura();
      buildDrone();
      setInterval(schedule, 25);
      requestAnimationFrame(drawLoop);
    }
    if (ctx.state === 'suspended') ctx.resume();
  }

  // ---------- plucked strings ----------
  function makeString(f, dur, seed) {
    const sr = ctx.sampleRate, N = Math.floor(sr * dur), out = new Float32Array(N);
    const H = Math.max(8, Math.min(48, Math.floor(7000 / f)));
    const ph = new Float64Array(H), inc = new Float64Array(H), base = new Float64Array(H),
          rate = new Float64Array(H), off = new Float64Array(H), env = new Float64Array(H);
    let r = seed; const rnd = () => (r = (r * 16807) % 2147483647) / 2147483647;
    for (let i = 0; i < H; i++) {
      const n = i + 1;
      inc[i] = 2 * Math.PI * f * n * (1 + 0.00012 * n) / sr;
      base[i] = 1 / Math.pow(n, 0.85);
      rate[i] = 0.12 + 0.035 * n + rnd() * 0.06;
      off[i] = rnd() * 6.283; ph[i] = rnd() * 6.283;
    }
    const BL = 64;
    for (let s = 0; s < N; s += BL) {
      const t = s / sr;
      const c = 2.5 + 15 * Math.exp(-t / 1.2);
      const amp = Math.min(1, t / 0.015) * Math.exp(-t / 2.8);
      for (let i = 0; i < H; i++) {
        const d = (i + 1 - c) / 3.5;
        env[i] = amp * base[i] * (0.25 + 1.2 * Math.exp(-d * d)) * (0.7 + 0.3 * Math.cos(6.283 * rate[i] * t + off[i]));
      }
      const end = Math.min(N, s + BL);
      for (let k = s; k < end; k++) {
        let v = 0;
        for (let i = 0; i < H; i++) { v += env[i] * Math.sin(ph[i]); ph[i] += inc[i]; }
        out[k] = v;
      }
    }
    const fade = Math.floor(sr * 0.4);
    for (let k = 0; k < fade; k++) out[N - 1 - k] *= k / fade;
    let peak = 0; for (let k = 0; k < N; k++) peak = Math.max(peak, Math.abs(out[k]));
    const g = 0.5 / (peak || 1);
    for (let k = 0; k < N; k++) out[k] *= g;
    const b = ctx.createBuffer(1, N, sr); b.getChannelData(0).set(out); return b;
  }
  function buildTanpura() {
    if (!ctx) return;
    if (building) { pendingBuild = true; return; }
    building = true; $('#tuneStatus').textContent = 'tuning…';
    const sa = saFreq();
    const freqs = [sa * FIRST[S.first], sa, sa * 1.0007, sa / 2];
    const bufs = []; let i = 0;
    const step = () => {
      bufs.push(makeString(freqs[i], 7, 1234 + i * 977)); i++;
      if (i < 4) setTimeout(step, 0);
      else {
        tanBufs = bufs; building = false; $('#tuneStatus').textContent = '';
        if (pendingBuild) { pendingBuild = false; buildTanpura(); }
      }
    };
    setTimeout(step, 0);
  }

  const PAN = [-0.35, -0.1, 0.12, 0.35];
  const LEVEL = [0.85, 0.75, 0.75, 1.0];
  let on = false, cycle = 0, idx = 0, uiQ = [];
  const offsets = () => { const sum = S.gaps.reduce((a, b) => a + b, 0); let acc = 0; return S.gaps.map(g => { const o = acc / sum; acc += g; return o; }); };
  function pluck(i, t) {
    const src = ctx.createBufferSource(); src.buffer = tanBufs[i];
    const g = ctx.createGain(); g.gain.value = LEVEL[i] * (0.9 + Math.random() * 0.1);
    let node = src;
    if (ctx.createStereoPanner) { const p = ctx.createStereoPanner(); p.pan.value = PAN[i]; src.connect(p); node = p; }
    node.connect(g); g.connect(tanGain); src.start(t);
    uiQ.push({ t, i });
  }
  function schedule() {
    const now = ctx.currentTime;
    if (!(on && S.pluckOn && tanBufs)) { cycle = Math.max(cycle, now); return; }
    const OFF = offsets();
    while (true) {
      const t = cycle + OFF[idx] * S.tSpeed;
      if (t > now + 0.15) break;
      if (t > now - 0.05) pluck(idx, Math.max(t, now));
      idx++;
      if (idx === 4) { idx = 0; cycle += S.tSpeed; }
    }
  }

  // ---------- drone ----------
  // Sustained tanpura tone (Sa, low Sa, first-string note) from the same harmonic recipe
  // as the plucks. Character comes from: a slow jawari sweep (the bright region of the
  // overtones drifts up and down), each overtone breathing at its own pace, and a second
  // middle-Sa string slightly off so the two beat gently. Every rate is a whole number of
  // cycles per LOOP, so the buffer loops without a seam.
  const LOOP = 8;
  let droneSrc = null, droneTimer = null;
  function makeDrone() {
    const sr = ctx.sampleRate, N = Math.floor(sr * LOOP), out = new Float32Array(N);
    const sa = saFreq(), br = S.dBright, sh = S.dShim;
    // [freq, level, extra beat cycles per loop (0 = none), sweep speed, sweep phase]
    const voices = [
      [sa,                   0.75, 0, 1, 0.0],
      [sa,                   0.55, 2, 2, 2.1],   // 2nd Sa string, beats at 0.25 Hz
      [sa / 2,               1.00, 0, 1, 4.2],
      [sa * FIRST[S.first],  0.55, 0, 2, 1.0],
    ];
    let r = 777; const rnd = () => (r = (r * 16807) % 2147483647) / 2147483647;
    const BL = 64, nb = Math.ceil(N / BL);
    voices.forEach(([f, lvl, beat, sweepK, sweepPh]) => {
      const H = Math.max(6, Math.min(40, Math.floor((2500 + 4500 * br) / f)));
      const roll = 1.45 - 0.7 * br;
      for (let n = 1; n <= H; n++) {
        const cyc = Math.round(f * n * LOOP) + beat * n;
        const w = 2 * Math.PI * cyc / N, p0 = rnd() * 6.283;
        const lfoK = 1 + Math.floor(rnd() * 4), lfoPh = rnd() * 6.283;
        const base = lvl / Math.pow(n, roll);
        let ph = p0;
        for (let b = 0; b < nb; b++) {
          const s0 = b * BL, t = s0 / N;                 // t in loop fractions, 0..1
          const c = 4.5 + sh * 4 * Math.sin(2 * Math.PI * sweepK * t + sweepPh);
          const d = (n - c) / 2.8;
          const a = base * (0.3 + 1.1 * Math.exp(-d * d)) * (1 - 0.4 * sh + 0.4 * sh * Math.cos(2 * Math.PI * lfoK * t + lfoPh));
          const end = Math.min(N, s0 + BL);
          for (let k = s0; k < end; k++) { out[k] += a * Math.sin(ph); ph += w; }
        }
      }
    });
    let peak = 0; for (let k = 0; k < N; k++) peak = Math.max(peak, Math.abs(out[k]));
    const g = 0.5 / (peak || 1); for (let k = 0; k < N; k++) out[k] *= g;
    const b = ctx.createBuffer(1, N, sr); b.getChannelData(0).set(out); return b;
  }
  function buildDrone() {
    if (!ctx) return;
    clearTimeout(droneTimer);
    droneTimer = setTimeout(() => {
      const buf = makeDrone(), t = ctx.currentTime;
      const src = ctx.createBufferSource(); src.buffer = buf; src.loop = true;
      const g = ctx.createGain(); g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime(1, t + 0.5);
      src.connect(g); g.connect(droneGain); src.start(t);
      if (droneSrc) { const old = droneSrc; old.g.gain.setValueAtTime(1, t); old.g.gain.linearRampToValueAtTime(0, t + 0.5); old.src.stop(t + 0.55); }
      droneSrc = { src, g };
    }, 60);
  }
  function applyDroneLevel() {
    if (!ctx) return;
    const target = on && S.droneOn ? S.dVol * 0.6 : 0;
    droneGain.gain.cancelScheduledValues(ctx.currentTime);
    droneGain.gain.setTargetAtTime(target, ctx.currentTime, on ? 0.6 : 0.25);
  }

  // ---------- transport ----------
  function toggle() {
    ensureCtx();
    on = !on;
    if (on) { cycle = ctx.currentTime + 0.05; idx = 0; } else uiQ = [];
    applyDroneLevel();
    $('#play').classList.toggle('on', on);
    $('#play').textContent = on ? '■ Stop' : '▶ Play';
  }

  // ---------- Sa & first string ----------
  const notesEl = $('#notes');
  NOTES.forEach((n, i) => {
    const b = document.createElement('button');
    b.textContent = n; if (n.includes('#')) b.classList.add('sharp');
    b.onclick = () => { S.sa = i; save(); renderSa(); buildTanpura(); buildDrone(); };
    notesEl.appendChild(b);
  });
  function renderSa() {
    [...notesEl.children].forEach((b, i) => b.classList.toggle('on', i === S.sa));
    $('#centsVal').textContent = (S.cents > 0 ? '+' : '') + S.cents + ' cents';
    $('#freqVal').textContent = NOTES[S.sa] + '3 · ' + saFreq().toFixed(2) + ' Hz';
  }
  $('#cents').value = S.cents;
  $('#cents').oninput = e => { S.cents = +e.target.value; renderSa(); };
  $('#cents').onchange = () => { save(); buildTanpura(); buildDrone(); };
  $('#firstStr').querySelectorAll('button').forEach(b => {
    b.onclick = () => { S.first = b.dataset.v; save(); renderFirst(); renderPattern(); buildTanpura(); buildDrone(); };
  });
  const renderFirst = () => $('#firstStr').querySelectorAll('button').forEach(b => b.classList.toggle('on', b.dataset.v === S.first));

  // ---------- sliders & toggles ----------
  function bindRange(id, fmt, apply) {
    const el = $('#' + id); el.value = S[id];
    const show = () => $('#' + id + 'Val').textContent = fmt(S[id]);
    el.oninput = () => { S[id] = +el.value; show(); apply && apply(); save(); };
    show();
  }
  const pct = v => Math.round(v * 100) + '%';
  bindRange('tSpeed', v => v.toFixed(1) + ' s', () => renderPattern());
  bindRange('tVol', pct, () => tanGain && tanGain.gain.setTargetAtTime(S.tVol, ctx.currentTime, 0.05));
  bindRange('dVol', pct, applyDroneLevel);
  bindRange('dBright', pct); bindRange('dShim', pct);
  ['#dBright', '#dShim'].forEach(id => $(id).addEventListener('change', buildDrone));

  function bindSwitch(id, card, apply) {
    const el = $('#' + id); el.checked = !!S[id];
    const show = () => $(card).querySelectorAll('.row, .tl, .presets, .ratio').forEach(n => n.classList.toggle('off', !S[id]));
    el.onchange = () => { S[id] = el.checked; save(); show(); apply && apply(); };
    show();
  }

  // ---------- EQ ----------
  // Four bands per channel: Body (low shelf), Warmth (low-mid), Buzz (presence), Air (high shelf).
  const BANDS = [
    { name:'Body',   type:'lowshelf',  f:120,  hint:'120 Hz' },
    { name:'Warmth', type:'peaking',   f:450,  hint:'450 Hz', q:0.9 },
    { name:'Buzz',   type:'peaking',   f:2200, hint:'2.2 kHz', q:0.9 },
    { name:'Air',    type:'highshelf', f:6000, hint:'6 kHz' },
  ];
  const eqNodes = {};
  function makeEQ(input, output, gains) {
    let node = input;
    const fs = BANDS.map((b, i) => {
      const f = ctx.createBiquadFilter(); f.type = b.type; f.frequency.value = b.f;
      if (b.q) f.Q.value = b.q; f.gain.value = gains[i];
      node.connect(f); node = f; return f;
    });
    node.connect(output);
    return fs;
  }
  function buildEQUI(key) {
    const box = $('#' + key);
    box.innerHTML = '<div class="top">Tone (EQ)<button>Reset</button></div><div class="bands"></div>';
    const bandsEl = box.querySelector('.bands'), inputs = [];
    const fmt = v => (v > 0 ? '+' : '') + v.toFixed(1) + ' dB';
    BANDS.forEach((b, i) => {
      const d = document.createElement('div'); d.className = 'band';
      d.innerHTML = '<label>' + b.name + ' <b></b></label><input type="range" min="-12" max="12" step="0.5"><small>' + b.hint + ' · double-click to zero</small>';
      const inp = d.querySelector('input'), out = d.querySelector('b');
      const set = v => {
        S[key][i] = v; inp.value = v; out.textContent = fmt(v);
        if (eqNodes[key]) eqNodes[key][i].gain.setTargetAtTime(v, ctx.currentTime, 0.03);
      };
      inp.oninput = () => { set(+inp.value); save(); };
      inp.ondblclick = () => { set(0); save(); };
      set(S[key][i]);
      bandsEl.appendChild(d); inputs.push(set);
    });
    box.querySelector('.top button').onclick = () => { inputs.forEach(set => set(0)); save(); };
  }
  buildEQUI('eqT'); buildEQUI('eqD');

  bindSwitch('pluckOn', '#pluckCard', () => { if (ctx) { cycle = ctx.currentTime + 0.05; idx = 0; } });
  bindSwitch('droneOn', '#droneCard', applyDroneLevel);

  // ---------- pattern editor ----------
  const segsEl = $('#segs'), tlEl = $('#tl');
  const segEls = [], handles = [];
  for (let i = 0; i < 4; i++) {
    const s = document.createElement('div'); s.className = 's';
    s.innerHTML = '<div class="n"></div><div class="v"></div>';
    segsEl.appendChild(s); segEls.push(s);
  }
  for (let k = 0; k < 3; k++) {
    const h = document.createElement('div'); h.className = 'h'; h.dataset.k = k;
    h.setAttribute('role', 'slider'); h.setAttribute('aria-label', 'Pluck boundary ' + (k + 1)); h.tabIndex = 0;
    tlEl.appendChild(h); handles.push(h);
  }
  const MIN = 0.05;
  function fracs() { const sum = S.gaps.reduce((a, b) => a + b, 0); return S.gaps.map(g => g / sum); }
  function renderPattern() {
    const f = fracs(), names = stringNames();
    let acc = 0;
    f.forEach((x, i) => {
      segEls[i].style.flex = '0 0 ' + (x * 100) + '%';
      segEls[i].querySelector('.n').textContent = names[i];
      segEls[i].querySelector('.v').textContent = (x * S.tSpeed).toFixed(2) + ' s';
      if (i < 3) { acc += x; handles[i].style.left = (acc * 100) + '%'; }
    });
    const secs = f.map(x => (x * S.tSpeed).toFixed(1));
    $('#ratio').innerHTML = names.map((n, i) => n + ' <b>' + secs[i] + 's</b>').join(' &nbsp;→&nbsp; ');
    const key = JSON.stringify(normalize(S.gaps));
    [...$('#presets').children].forEach((b, i) => b.classList.toggle('on', JSON.stringify(normalize(PRESETS[i].g)) === key));
  }
  const normalize = g => { const s = g.reduce((a, b) => a + b, 0); return g.map(x => Math.round(x / s * 1000)); };
  function setBoundary(k, pos) {
    const f = fracs();
    const b = [f[0], f[0] + f[1], f[0] + f[1] + f[2]];
    const lo = (k === 0 ? 0 : b[k - 1]) + MIN, hi = (k === 2 ? 1 : b[k + 1]) - MIN;
    b[k] = Math.max(lo, Math.min(hi, pos));
    S.gaps = [b[0], b[1] - b[0], b[2] - b[1], 1 - b[2]].map(x => Math.round(x * 1000) / 10);
    renderPattern();
  }
  handles.forEach(h => {
    const k = +h.dataset.k;
    h.addEventListener('pointerdown', e => {
      e.preventDefault(); h.setPointerCapture(e.pointerId); h.classList.add('drag');
      const move = ev => { const r = tlEl.getBoundingClientRect(); setBoundary(k, (ev.clientX - r.left) / r.width); };
      const up = () => { h.classList.remove('drag'); h.removeEventListener('pointermove', move); h.removeEventListener('pointerup', up); h.removeEventListener('pointercancel', up); save(); };
      h.addEventListener('pointermove', move); h.addEventListener('pointerup', up); h.addEventListener('pointercancel', up);
    });
    h.addEventListener('keydown', e => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      e.preventDefault(); e.stopPropagation();
      const f = fracs(); const cur = f.slice(0, k + 1).reduce((a, b) => a + b, 0);
      setBoundary(k, cur + (e.key === 'ArrowRight' ? 0.01 : -0.01)); save();
    });
  });
  PRESETS.forEach(p => {
    const b = document.createElement('button'); b.textContent = p.name;
    b.onclick = () => { S.gaps = p.g.slice(); save(); renderPattern(); };
    $('#presets').appendChild(b);
  });

  function drawLoop() {
    while (uiQ.length && uiQ[0].t <= ctx.currentTime) {
      const el = segEls[uiQ.shift().i];
      el.classList.add('hit'); setTimeout(() => el.classList.remove('hit'), 140);
    }
    requestAnimationFrame(drawLoop);
  }

  $('#play').onclick = toggle;
  document.addEventListener('keydown', e => {
    if (e.code === 'Space' && !/INPUT|SELECT|TEXTAREA/.test(e.target.tagName)) { e.preventDefault(); toggle(); }
  });

  renderSa(); renderFirst(); renderPattern();
})();
</script>
</body>
</html>
